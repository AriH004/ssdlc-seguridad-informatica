{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env*)",
      "Edit(.github/workflows/**)",
      "Edit(.claude/**)",
      "Edit(scripts/verify.sh)",
      "Edit(scripts/ci/**)",
      "Edit(.semgrep/**)",
      "Edit(.gitleaks.toml)",
      "Edit(osv-scanner.toml)",
      "Edit(backend/test/**)",
      "Edit(frontend/tests/**)",
      "Bash(git push*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr review*)",
      "Bash(gh pr approve*)",
      "Bash(rm -rf *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-verify.sh",
            "timeout": 300,
            "statusMessage": "Ejecutando verificaciones locales de calidad y seguridad (verify.sh)..."
          }
        ]
      }
    ]
  }
}
